{
  "realm": "dtp-local",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 120,
  "roles": {
    "realm": [
      {
        "name": "transfer-client"
      },
      {
        "name": "auditor"
      },
      {
        "name": "operator"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dtp-operator",
      "secret": "${DTP_OPERATOR_SECRET}",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "transfer:operate"
      ],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "${DTP_TENANT_ID}",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dtp-ledger",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dtp-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8999/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "transfer:read",
        "transfer:write",
        "activity:read"
      ],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aud",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dtp-ledger",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "activity-aud",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dtp-activity",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "transfer:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "transfer:operate",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "transfer:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "activity:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-dtp-operator",
      "enabled": true,
      "serviceAccountClientId": "dtp-operator",
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "alice",
      "attributes": {
        "tenant_id": [
          "${DTP_TENANT_ID}"
        ]
      },
      "enabled": true,
      "email": "alice@example.invalid",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Synthetic",
      "realmRoles": [
        "transfer-client"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DTP_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "id": "40000000-0000-0000-0000-000000000001"
    }
  ]
}
